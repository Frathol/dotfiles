{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "padding": {
      "top": 2,
      "left": 2,
      "right": 3,
    },
    "color": {
      "1": "cyan",
      "2": "blue",
    },
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan",
      "title": "blue",
    },
  },
  "modules": [
    {
      "type": "title",
      "format": "  {user-name-colored}@{host-name-colored}",
    },
    {
      "type": "custom",
      "format": "╭──────────────────────────────╮",
    },
    {
      "type": "os",
      "key": "│  OS     ",
      "format": "{name}",
    },
    {
      "type": "kernel",
      "key": "│  Kernel ",
      "format": "{release}",
    },
    {
      "type": "wm",
      "key": "│  WM     ",
      "format": "{pretty-name}",
    },
    {
      "type": "terminal",
      "key": "│  Term   ",
      "format": "{pretty-name}",
    },
    {
      "type": "packages",
      "key": "│ 󰏖 Pkgs   ",
    },
    {
      "type": "uptime",
      "key": "│  Uptime ",
    },
    {
      "type": "cpu",
      "key": "│  CPU    ",
      "format": "{name}",
    },
    {
      "type": "gpu",
      "key": "│ 󰢮 GPU    ",
      "format": "{name}",
    },
    {
      "type": "memory",
      "key": "│ 󰍛 Memory ",
      "format": "{used} / {total} ({percentage})",
    },
    {
      "type": "cpuusage",
      "key": "│ 󰓅 Load   ",
      "format": "{avg}",
    },
    {
      "type": "battery",
      "key": "│ 󰁹 Battery",
      "format": "{capacity} ({status})",
    },
    {
      "type": "custom",
      "format": "╰──────────────────────────────╯",
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle",
    },
  ],
}
